{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tlaw.agent-task/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "main_sha", "sources", "objective", "constraints"],
  "properties": {
    "schema": { "type": "string", "const": "tlaw.agent-task/v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "main_sha": { "type": "string", "minLength": 40, "maxLength": 40 },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "objective": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
