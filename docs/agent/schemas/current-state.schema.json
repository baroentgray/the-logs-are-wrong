{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tlaw.current-state/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "non_authoritative", "snapshot_kind", "stage", "verified_main", "completed_tasks", "active_task", "active_pr", "candidate_sha", "open_blockers", "next_action", "source_links", "staleness_rule", "prepared_target_note"],
  "properties": {
    "schema": { "const": "tlaw.current-state/v1" },
    "non_authoritative": { "const": true },
    "snapshot_kind": { "enum": ["prepared_target", "live_checkpoint"] },
    "stage": { "enum": ["MERGED_AND_VERIFIED", "CHAT_HANDOFF_CREATED"] },
    "verified_main": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "workflow", "job", "artifact", "artifact_id", "artifact_digest", "tests_passed", "tests_failed", "tests_skipped", "build_warnings", "build_errors", "clean_tree", "diff_check", "gate_0", "architecture", "domain_dependencies", "git_object_reader"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "workflow": { "type": "string", "minLength": 1 },
        "job": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "tests_passed": { "type": "integer" },
        "tests_failed": { "type": "integer" },
        "tests_skipped": { "type": "integer" },
        "build_warnings": { "type": "integer" },
        "build_errors": { "type": "integer" },
        "clean_tree": { "type": "boolean" },
        "diff_check": { "type": "boolean" },
        "gate_0": { "type": "boolean" },
        "architecture": { "type": "boolean" },
        "domain_dependencies": { "type": "boolean" },
        "git_object_reader": { "type": "boolean" }
      }
    },
    "completed_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "github_issue", "pull_request", "linear_issue", "status"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "github_issue": { "type": "string", "minLength": 1 },
          "pull_request": { "type": "string", "minLength": 1 },
          "linear_issue": { "type": "string", "minLength": 1 },
          "status": { "const": "completed" }
        }
      }
    },
    "active_task": { "type": ["string", "null"] },
    "active_pr": { "type": ["integer", "null"] },
    "candidate_sha": { "type": ["string", "null"] },
    "open_blockers": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string", "minLength": 1 },
    "source_links": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "staleness_rule": { "type": "string", "minLength": 1 },
    "prepared_target_note": { "type": "string", "minLength": 1 }
  }
}
