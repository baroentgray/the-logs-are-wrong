{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tlaw.agent-review/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "reviewed_head", "verdict", "human_summary", "evidence", "findings"],
  "properties": {
    "schema": { "type": "string", "const": "tlaw.agent-review/v1" },
    "task_id": { "type": "string", "minLength": 1 },
    "reviewed_head": { "type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9A-Fa-f]{40}$" },
    "verdict": { "type": "string", "enum": ["approve", "request_changes", "comment"] },
    "human_summary": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference"],
        "properties": {
          "kind": { "type": "string", "enum": ["command", "source", "file", "ci"] },
          "reference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "summary", "evidence"],
        "properties": {
          "severity": { "type": "string", "enum": ["blocker", "high", "medium", "low", "info"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
