{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tlaw.chat-handoff/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "non_authoritative", "snapshot_kind", "mode", "source_hierarchy", "verified_main", "completed_tasks", "current_operational_task", "unresolved_questions", "accepted_process_decisions", "decision_references", "next_action", "startup_reading_order", "live_validation_required", "old_chat_non_authoritative", "unverified_baseline_forbidden", "silent_reviewer_policy_change_forbidden", "prepared_target_note"],
  "properties": {
    "schema": { "const": "tlaw.chat-handoff/v1" },
    "non_authoritative": { "const": true },
    "snapshot_kind": { "enum": ["prepared_target", "live_checkpoint"] },
    "mode": { "const": "development_control_center" },
    "source_hierarchy": { "type": "array", "minItems": 6, "items": { "type": "string", "minLength": 1 } },
    "verified_main": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "workflow", "job", "artifact", "artifact_id", "artifact_digest"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "workflow": { "type": "string", "minLength": 1 },
        "job": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "completed_tasks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "summary", "source_link"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "source_link": { "type": "string", "minLength": 1 }
        }
      }
    },
    "current_operational_task": { "type": ["string", "null"] },
    "unresolved_questions": { "type": "array", "items": { "type": "string" } },
    "accepted_process_decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "decision_references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "next_action": { "type": "string", "minLength": 1 },
    "startup_reading_order": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 1 } },
    "live_validation_required": { "const": true },
    "old_chat_non_authoritative": { "const": true },
    "unverified_baseline_forbidden": { "const": true },
    "silent_reviewer_policy_change_forbidden": { "const": true },
    "prepared_target_note": { "type": "string", "minLength": 1 }
  }
}
