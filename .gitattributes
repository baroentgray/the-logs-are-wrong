*.tiff filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text

# Unity writes its serialized YAML with trailing spaces after empty keys
# (userData:, assetBundleName:, m_Name:). These files are editor-generated and
# regenerated on every save, so they are exempt from whitespace linting.
# Scoped to generated serialization only: hand-written .cs/.json/.asmdef inside
# the Unity project remain whitespace-checked.
unity/TheLogsAreWrong/**/*.asset -whitespace
unity/TheLogsAreWrong/**/*.meta -whitespace
unity/TheLogsAreWrong/**/*.unity -whitespace
