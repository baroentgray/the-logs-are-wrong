# Unity writes its serialized YAML with trailing spaces after empty keys
# (userData:, assetBundleName:, m_Name:). These files are editor-generated and
# regenerated on every save, so they are exempt from whitespace linting.
# Scoped to generated serialization only: hand-written .cs/.json/.asmdef inside
# the Unity project remain whitespace-checked.
unity/TheLogsAreWrong/**/*.asset -whitespace
unity/TheLogsAreWrong/**/*.meta -whitespace
unity/TheLogsAreWrong/**/*.unity -whitespace

# Preserve the accepted official FishySteamworks artifact byte-for-byte. The
# release contains CRLF source files and three upstream trailing-whitespace
# lines; normalizing or trimming them would alter the accepted artifact.
unity/TheLogsAreWrong/Assets/FishNet/Plugins/FishySteamworks/** -text -eol whitespace=-trailing-space

# Preserve the exact official SteamManager source carried by the accepted Fishy release artifact.
unity/TheLogsAreWrong/Assets/Scripts/Steamworks.NET/SteamManager.cs -text -eol whitespace=-trailing-space

# Preserve exact imported 3D provenance reports. Trailing spaces are markdown
# hard line-breaks in immutable evidence; trimming would change recorded SHA-256.
# Path-specific only. Do not broaden to *.md or art/.
art/environment/sawmill/TLAW_COMPOUND_APPLICATOR_01_CORR01.report.md whitespace=-trailing-space
art/environment/sawmill/TLAW_COMPOUND_APPLICATOR_01_CORR01_REVIEW_01.report.md whitespace=-trailing-space
art/environment/sawmill/TLAW_COMPOUND_APPLICATOR_01_CORR01_CANONICAL_INTEGRATION_01.report.md whitespace=-trailing-space
art/environment/sawmill/TLAW_COMPOUND_APPLICATOR_01_COMPOUND_PROXY_CLEANUP_01.report.md whitespace=-trailing-space
art/environment/sawmill/TLAW_COMPOUND_APPLICATOR_01_COMPOUND_PROXY_CLEANUP_01_REVIEW_01.report.md whitespace=-trailing-space
